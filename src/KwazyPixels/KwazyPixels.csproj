    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a6968d30-9801-4359-aa23-188d2f553423</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
